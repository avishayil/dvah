# DVAH configuration (copy to .env or export in your shell). All are optional.
# Most settings are also editable at runtime from the web UI Settings page.

# --- Web API (dvah/webapi) --------------------------------------------------
# Sandbox runner for untrusted learner code: "subprocess" (default) or "docker".
DVAH_RUNNER=subprocess
# Max concurrent lab runs.
DVAH_RUN_CONCURRENCY=2
# Comma-separated allowed browser origins for CORS ("*" for local dev).
DVAH_CORS_ORIGINS=http://localhost:3000

# --- Optional AI tutor ------------------------------------------------------
# Enable the Socratic coach (also needs a provider credential below).
DVAH_TUTOR=0
# One of: anthropic | openai | bedrock
DVAH_TUTOR_PROVIDER=anthropic

# --- Model provider credentials (only what your chosen provider needs) ------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock: a Bedrock API key (bearer token) OR the standard AWS chain.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# --- Frontend (web/) --------------------------------------------------------
# Base URL the browser uses to reach the API (build-time for Next.js).
NEXT_PUBLIC_API_BASE=http://localhost:8000
